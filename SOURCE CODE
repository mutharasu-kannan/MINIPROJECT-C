#include <stdio.h>
#include <string.h>

#define SIZE 100

struct clientData
{
    unsigned int acctNum;
    char lastName[15];
    char firstName[10];
    double balance;
};

unsigned int enterChoice(void);
void textFile();
void updateRecord();
void newRecord();
void deleteRecord();
void transferAmount();
void displayAccount();   // NEW FUNCTION

struct clientData clients[SIZE];

int main()
{
    unsigned int choice;

    while ((choice = enterChoice()) != 7)
    {
        switch (choice)
        {
            case 1:
                textFile();
                break;
            case 2:
                updateRecord();
                break;
            case 3:
                newRecord();
                break;
            case 4:
                deleteRecord();
                break;
            case 5:
                transferAmount();
                break;
            case 6:
                displayAccount();   // NEW OPTION
                break;
            default:
                puts("Incorrect choice");
                break;
        }
    }

    return 0;
}

/* DISPLAY ALL ACCOUNTS */
void textFile()
{
    printf("%-6s%-16s%-11s%10s\n", "Acct", "Last Name", "First Name", "Balance");

    for (int i = 0; i < SIZE; i++)
    {
        if (clients[i].acctNum != 0)
        {
            printf("%-6d%-16s%-11s%10.2f\n",
                   clients[i].acctNum,
                   clients[i].lastName,
                   clients[i].firstName,
                   clients[i].balance);
        }
    }
}

/* DISPLAY SINGLE ACCOUNT */
void displayAccount()
{
    unsigned int account;

    printf("Enter account number to display ( 1 - 100 ): ");
    scanf("%d", &account);

    if (clients[account - 1].acctNum == 0)
    {
        printf("Account #%d has no information.\n", account);
    }
    else
    {
        printf("\nACCOUNT DETAILS:\n");
        printf("%-6d%-16s%-11s%10.2f\n",
               clients[account - 1].acctNum,
               clients[account - 1].lastName,
               clients[account - 1].firstName,
               clients[account - 1].balance);
    }
}

void updateRecord()
{
    unsigned int account;
    double transaction;

    printf("Enter account to update ( 1 - 100 ): ");
    scanf("%d", &account);

    if (clients[account - 1].acctNum == 0)
    {
        printf("Account #%d has no information.\n", account);
    }
    else
    {
        printf("%-6d%-16s%-11s%10.2f\n\n",
               clients[account - 1].acctNum,
               clients[account - 1].lastName,
               clients[account - 1].firstName,
               clients[account - 1].balance);

        printf("Enter charge ( + ) or payment ( - ): ");
        scanf("%lf", &transaction);

        clients[account - 1].balance += transaction;

        printf("%-6d%-16s%-11s%10.2f\n",
               clients[account - 1].acctNum,
               clients[account - 1].lastName,
               clients[account - 1].firstName,
               clients[account - 1].balance);
    }
}

void deleteRecord()
{
    unsigned int accountNum;

    printf("Enter account number to delete ( 1 - 100 ): ");
    scanf("%d", &accountNum);

    if (clients[accountNum - 1].acctNum == 0)
    {
        printf("Account %d does not exist.\n", accountNum);
    }
    else
    {
        clients[accountNum - 1].acctNum = 0;
        strcpy(clients[accountNum - 1].lastName, "");
        strcpy(clients[accountNum - 1].firstName, "");
        clients[accountNum - 1].balance = 0.0;
    }
}

void newRecord()
{
    unsigned int accountNum;

    printf("Enter new account number ( 1 - 100 ): ");
    scanf("%d", &accountNum);

    if (clients[accountNum - 1].acctNum != 0)
    {
        printf("Account #%d already contains information.\n",
               clients[accountNum - 1].acctNum);
    }
    else
    {
        printf("Enter lastname, firstname, balance\n? ");
        scanf("%14s%9s%lf",
              clients[accountNum - 1].lastName,
              clients[accountNum - 1].firstName,
              &clients[accountNum - 1].balance);

        clients[accountNum - 1].acctNum = accountNum;
    }
}

void transferAmount()
{
    unsigned int fromAcc, toAcc;
    double amount;

    printf("Enter account number to transfer FROM ( 1 - 100 ): ");
    scanf("%d", &fromAcc);

    printf("Enter account number to transfer TO ( 1 - 100 ): ");
    scanf("%d", &toAcc);

    if (clients[fromAcc - 1].acctNum == 0 ||
        clients[toAcc - 1].acctNum == 0)
    {
        printf("One of the accounts does not exist.\n");
        return;
    }

    printf("Enter amount to transfer: ");
    scanf("%lf", &amount);

    if (clients[fromAcc - 1].balance < amount)
    {
        printf("Insufficient balance in account #%d\n", fromAcc);
        return;
    }

    clients[fromAcc - 1].balance -= amount;
    clients[toAcc - 1].balance += amount;

    printf("\nTransfer Successful!\n\n");

    printf("FROM ACCOUNT DETAILS:\n");
    printf("%-6d%-16s%-11s%10.2f\n",
           clients[fromAcc - 1].acctNum,
           clients[fromAcc - 1].lastName,
           clients[fromAcc - 1].firstName,
           clients[fromAcc - 1].balance);

    printf("\nTO ACCOUNT DETAILS:\n");
    printf("%-6d%-16s%-11s%10.2f\n",
           clients[toAcc - 1].acctNum,
           clients[toAcc - 1].lastName,
           clients[toAcc - 1].firstName,
           clients[toAcc - 1].balance);
}

unsigned int enterChoice(void)
{
    unsigned int menuChoice;

    printf("\nEnter your choice\n"
           "1 - store a formatted text file of accounts called\n"
           "    \"accounts.txt\" for printing\n"
           "2 - update an account\n"
           "3 - add a new account\n"
           "4 - delete an account\n"
           "5 - transfer amount between accounts\n"
           "6 - display single account details\n"
           "7 - end program\n? ");

    scanf("%u", &menuChoice);
    return menuChoice;
}
